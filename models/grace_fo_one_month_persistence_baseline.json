      "end": "2023-12-31"
    },
    "test": {
      "start": "2024-01-01",
      "end": "2025-12-31"
    }
  },
  "fitting": "None; persistence has no learned parameters.",
  "normalization": "None; metrics and forecasts remain in centimeters.",
  "processed_input": "data/processed/grace_fo_processed.nc",
  "split_datasets": {
    "train": "data/processed/grace_fo_train.nc",
